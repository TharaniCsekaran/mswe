# Contact form API folder
Options -Indexes

# Never serve mail config files over the web (Apache 2.4 and 2.2 syntax)
<FilesMatch "^(mail-config.*|mswe-mail-config)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
